---
import Base from '../layouts/Base.astro';
import { site, calUrl } from '../lib/links';
---
<Base title="Страница не найдена — LossMap" noindex>
  <section class="section container nf">
    <p class="eyebrow mono">404</p>
    <h1>Такой страницы нет</h1>
    <p class="lead">Возможно, ссылка устарела. Начните с главной или сразу запишитесь на разбор.</p>
    <div class="nf-cta">
      <a class="btn btn-primary" href={calUrl} data-cal>{site.cta.header}</a>
      <a class="btn btn-ghost" href="/">На главную</a>
    </div>
  </section>
</Base>

<style>
  .nf { display: flex; flex-direction: column; gap: 18px; min-height: 50vh; }
  .nf h1 { font-size: clamp(36px, 6vw, 60px); font-weight: 800; line-height: 1.04; letter-spacing: -0.03em; }
  .nf-cta { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
