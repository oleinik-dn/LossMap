---
import Base from '../layouts/Base.astro';
import { Content, frontmatter } from '../content/ru/privacy.md';
import { isPlaceholder } from '../lib/links';
---
<Base title={`${frontmatter.title} — LossMap`} description={frontmatter.description}>
  <article class="section container prose">
    <p class="eyebrow">LossMap</p>
    <h1>{frontmatter.title}</h1>
    <p class="upd">Редакция от {isPlaceholder(frontmatter.updated) ? <span class="placeholder">{frontmatter.updated}</span> : frontmatter.updated}</p>
    <Content />
  </article>
</Base>

<style>
  .prose { max-width: 820px; }
  .prose h1 { font-size: clamp(32px, 5vw, 48px); font-weight: 800; line-height: 1.1; margin: 12px 0 8px; }
  .upd { color: var(--muted); font-size: 15px; margin-bottom: 24px; }
  .prose :global(h2) { font-size: 24px; margin: 40px 0 12px; }
  .prose :global(p), .prose :global(li) { color: var(--text-2); }
  .prose :global(p) { margin: 0 0 14px; }
  .prose :global(ul) { padding-left: 20px; margin: 0 0 14px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(strong) { color: var(--text); }
  .prose :global(code) { font-family: var(--font-mono); font-size: .9em; background: var(--surface-2); padding: 1px 5px; border-radius: 4px; }
</style>
