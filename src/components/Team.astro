---
import SectionHead from './SectionHead.astro';
import T from './T.astro';
import d from '../content/ru/team.json';
---
<section class="section container" id="team" aria-labelledby="team-h">
  <SectionHead id="team-h" eyebrow={d.eyebrow} title={d.title} lead={d.lead} />
  <ul class="team">
    {d.members.map((m) => (
      <li class="card member">
        <div class="photo">
          {m.photo ? <img src={m.photo} alt={m.name} width="120" height="120" loading="lazy" decoding="async" /> : <span class="placeholder">{d.photoPlaceholder}</span>}
        </div>
        <div class="m-body">
          <h3><T v={m.name} /></h3>
          <p class="m-role mono">{m.role}</p>
          <p class="m-bio"><T v={m.bio} /></p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .team { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 16px; }
  .member { display: flex; gap: 24px; align-items: flex-start; }
  .photo { width: 120px; height: 120px; flex: none; border-radius: 12px; background: var(--surface-2); display: grid; place-items: center; overflow: hidden; text-align: center; font-size: 12px; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .m-body { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .m-role { font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .m-bio { font-size: 15px; color: var(--text-2); }
  @media (max-width: 480px) { .member { flex-direction: column; } }
</style>
