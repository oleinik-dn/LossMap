---
import Counter from './Counter.astro';
import hero from '../content/ru/hero.json';

const { pareto, tiles } = hero;
const max = Math.max(...pareto.items.map((i) => i.value));
const total = pareto.items.reduce((s, i) => s + i.value, 0);
const colors = ['var(--loss)', 'var(--loss)', 'var(--loss-2)', 'var(--loss-3)', 'var(--loss-4)'];
const aria = `${pareto.title}, ${pareto.note}: ` +
  pareto.items.map((i) => `${i.label.toLowerCase()} ${i.value}`).join(', ') +
  `; всего ${total} ${pareto.unit} за смену`;
const tileDelay = 250 * pareto.items.length + 450; // плитки — после последней полосы
---
<figure class="pareto card" data-reveal>
  <figcaption class="p-head">
    <span class="p-title">{pareto.title}</span>
    <span class="p-note mono">{pareto.note}</span>
  </figcaption>
  <div class="p-rows" role="img" aria-label={aria}>
    {pareto.items.map((i, n) => (
      <div class="p-row" aria-hidden="true">
        <span class="p-label">{i.label}</span>
        <div class="p-track">
          <div class="p-bar" style={`width:${(i.value / max) * 100}%;background:${colors[n] ?? 'var(--loss-4)'};--d:${0.2 + n * 0.25}s`}></div>
        </div>
        <span class="p-val mono">{i.value}</span>
      </div>
    ))}
  </div>
  <div class="p-tiles" style={`--d:${tileDelay / 1000}s`}>
    <div class="tile">
      <span class="t-label">{tiles.oee.label}</span>
      <Counter class="t-val" value={tiles.oee.value} delay={tileDelay} suffix={tiles.oee.suffix} />
    </div>
    <div class="tile">
      <span class="t-label">{tiles.loss.label}</span>
      <Counter class="t-val t-loss" value={tiles.loss.value} delay={tileDelay} suffix={tiles.loss.suffix} />
    </div>
    <div class="tile">
      <span class="t-label">{tiles.money.label}</span>
      <span class="t-val t-gain mono">{tiles.money.text}</span>
    </div>
  </div>
</figure>

<style>
  .pareto { margin: 0; display: flex; flex-direction: column; gap: 22px; }
  .p-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .p-title { font: 700 18px/1.3 var(--font-head); }
  .p-note { font-size: 12px; color: var(--muted); }
  .p-rows { display: flex; flex-direction: column; gap: 14px; }
  .p-row { line-height: 1.2; display: grid; grid-template-columns: 150px minmax(0, 1fr) 44px; gap: 12px; align-items: center; font-size: 14px; }
  .p-label { color: var(--text-2); }
  .p-track { height: 14px; background: var(--surface-2); border-radius: 3px; }
  .p-bar { height: 14px; border-radius: 3px; transform-origin: left; }
  .p-val { text-align: right; }
  .p-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; border-top: 1px solid var(--border); padding-top: 18px; }
  .tile { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .t-label { font-size: 12px; color: var(--muted); }
  .tile :global(.t-val) { font-size: 22px; font-weight: 600; line-height: 1.3; }
  .tile :global(.t-loss) { color: var(--loss); }
  .tile :global(.t-gain) { color: var(--gain); }

  /* Анимация: только при JS, запуск по .is-in (scripts/reveal.ts) */
  :global(html.js) .p-bar { transform: scaleX(0); }
  :global(html.js) .p-tiles { opacity: 0; transform: translateY(8px); }
  :global(html.js) .pareto.is-in .p-bar { animation: grow .9s cubic-bezier(.2,.7,.2,1) var(--d) both; }
  :global(html.js) .pareto.is-in .p-tiles { animation: fade .6s ease-out var(--d) both; }
  @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .p-bar, :global(html.js) .p-tiles { transform: none; opacity: 1; }
  }

  @media (max-width: 520px) {
    .pareto { padding: 20px; }
    .p-row { grid-template-columns: 112px minmax(0, 1fr) 28px; gap: 10px; font-size: 13px; }
    .tile :global(.t-val) { font-size: 20px; }
    .p-tiles { grid-template-columns: 1fr 1fr; gap: 14px 12px; }
    .tile:last-child { grid-column: 1 / -1; }
  }
</style>
