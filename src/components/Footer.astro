---
import { site, emailUrl, telegramUrl, whatsappUrl, isPlaceholder } from '../lib/links';
const c = site.contacts;
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="container ftr-in">
    <span>{site.footer.copyright.replace('{year}', String(year))}</span>
    <ul class="ftr-links">
      <li>{isPlaceholder(c.email) ? <span class="placeholder">{c.email}</span> : <a href={emailUrl}>{c.email}</a>}</li>
      <li><a href={telegramUrl} data-msg="tg">Telegram</a></li>
      <li><a href={whatsappUrl} data-msg="wa">WhatsApp</a></li>
      <li><a href={site.links.privacy}>{site.footer.privacy}</a></li>
    </ul>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--divider); background: var(--bg); color: var(--muted); font-size: 15px; }
  .ftr-in { display: flex; flex-wrap: wrap; gap: 16px 32px; justify-content: space-between; align-items: center; padding-block: 32px; }
  .ftr-links { display: flex; flex-wrap: wrap; gap: 12px 24px; list-style: none; margin: 0; padding: 0; }
  .ftr a { color: var(--text-2); }
  .ftr a:hover { color: var(--gain); }
</style>
