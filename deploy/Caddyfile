# Caddy для lossmap.pro. Сертификаты Let's Encrypt — автоматически.
# Переменные берутся из deploy/.env (docker compose передаёт их в контейнер).

{
	email {$ACME_EMAIL}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
		-Server
	}
}

www.lossmap.pro {
	redir https://lossmap.pro{uri} permanent
}

lossmap.pro {
	import security
	root * /srv/site
	encode zstd gzip

	# CSP: всё своё. Сторонний источник — только Umami на своём поддомене.
	# Хэш — единственный inline-скрипт (класс .js в <head>); проверяется scripts/check-csp.mjs при деплое.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' https://stats.lossmap.pro; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://stats.lossmap.pro; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

	# Кэш: файлы с хэшем в имени — навсегда; шрифты и картинки — месяц; HTML — всегда проверять.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@static path /fonts/* /favicon.svg /og-image.png /files/* /team/*
	header @static Cache-Control "public, max-age=2592000"
	header ?Cache-Control "no-cache"

	# Красивые адреса: /index.html → /, /privacy.html → /privacy; /privacy отдаёт privacy.html
	@index path_regexp idx ^(.*)/index\.html$
	redir @index {re.idx.1}/ permanent
	@ext path_regexp ext ^(/.+)\.html$
	redir @ext {re.ext.1} permanent
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

stats.lossmap.pro {
	import security
	encode zstd gzip
	reverse_proxy umami:3000
}
